<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>RigSight.Agent</RootNamespace>
    <AssemblyName>RigSight.Agent</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- The WPF manifest owns DPI awareness; WinForms' analyzer prefers its own switch. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigSight.Core\RigSight.Core.csproj" />
    <ProjectReference Include="..\RigSight.Windows\RigSight.Windows.csproj" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <!-- WinForms implicit usings collide with WPF names (Brush, Application, UserControl). -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

  <ItemGroup Condition="Exists('..\..\..\tools\presentmon\PresentMon.exe')">
    <None Include="..\..\..\tools\presentmon\PresentMon.exe" Link="tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
