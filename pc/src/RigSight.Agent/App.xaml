<Application x:Class="RigSight.Agent.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:RigSight.Agent.Converters"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Styles/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <conv:BoolToVisibilityConverter x:Key="InverseBoolToVis" Invert="True" />
            <conv:PageVisibilityConverter x:Key="PageVis" />
            <conv:StringToVisibilityConverter x:Key="StringToVis" />
            <conv:StringToVisibilityConverter x:Key="InverseStringToVis" Invert="True" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
