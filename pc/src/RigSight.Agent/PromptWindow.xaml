<Window x:Class="RigSight.Agent.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RigSight prompt"
        Width="392"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Topmost="True"
        WindowStartupLocation="Manual">

    <Border x:Name="RootCard"
            Background="#121822"
            BorderBrush="#334157"
            BorderThickness="1"
            CornerRadius="16"
            Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="26" ShadowDepth="8" Opacity="0.55" Color="#000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Ellipse Width="7" Height="7" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="GAME DETECTED"
                               Margin="8,0,0,0"
                               FontSize="10.5"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                </StackPanel>
                <TextBlock x:Name="CountdownText"
                           Text="AUTO-HIDES IN 20 S"
                           HorizontalAlignment="Right"
                           FontSize="9.5"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextFaintBrush}" />
            </Grid>

            <TextBlock x:Name="GameNameText"
                       Grid.Row="1"
                       Margin="0,12,0,0"
                       FontFamily="{StaticResource DisplayFont}"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextTrimming="CharacterEllipsis" />

            <TextBlock Grid.Row="2"
                       Margin="0,5,0,0"
                       Text="Start a telemetry session? The game stays fullscreen — no overlay, no injection."
                       FontSize="12.5"
                       LineHeight="19"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextDimBrush}" />

            <Grid Grid.Row="3" Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="StartButton"
                        Style="{StaticResource PrimaryButton}"
                        Content="Start tracking"
                        HorizontalAlignment="Stretch"
                        Click="OnStartClicked" />
                <Button x:Name="DeclineButton"
                        Grid.Column="1"
                        Margin="8,0,0,0"
                        Style="{StaticResource SecondaryButton}"
                        Content="Not now"
                        Click="OnDeclineClicked" />
            </Grid>

            <TextBlock x:Name="StatusText"
                       Grid.Row="4"
                       Margin="0,12,0,0"
                       Text="The phone prompt stays valid for 60 seconds. Ctrl+Alt+G starts it too."
                       FontSize="10.5"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource TextFaintBrush}" />
        </Grid>
    </Border>
</Window>
