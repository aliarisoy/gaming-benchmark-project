<Window x:Class="RigSight.Agent.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:RigSight.Agent.Views"
        mc:Ignorable="d"
        Title="RigSight"
        Width="1220" Height="800"
        MinWidth="980" MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        Closing="OnWindowClosing"
        StateChanged="OnWindowStateChanged">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0"
                Background="{StaticResource SidebarBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0">
            <Grid Margin="18,24,18,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <Border Width="38" Height="38" CornerRadius="11"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock Text="R"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   Foreground="#06110D"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="RIGSIGHT"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="PC GAMING TELEMETRY"
                                   FontSize="8.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextFaintBrush}" />
                    </StackPanel>
                </StackPanel>

                <ListBox Grid.Row="2"
                         Style="{StaticResource NavList}"
                         ItemsSource="{Binding NavItems}"
                         ItemTemplate="{StaticResource NavItemTemplate}"
                         SelectedIndex="{Binding PageIndex, Mode=TwoWay}" />

                <Border Grid.Row="3" Style="{StaticResource Card}" Padding="12" CornerRadius="11">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding TransportLabel}"
                                       Margin="7,0,0,0"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                        <TextBlock Text="{Binding PcName}"
                                   Margin="0,6,0,0"
                                   FontSize="12.5"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding ClientCountText}"
                                   Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="{StaticResource TextFaintBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main area -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="28,22,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel>
                        <TextBlock Text="THIS PC" Style="{StaticResource Overline}" />
                        <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                            <TextBlock Text="{Binding PcName}" Style="{StaticResource H2}" />
                            <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Padding="8,2">
                                <TextBlock Text="{Binding ElevationText}"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextDimBrush}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Style="{StaticResource Chip}" Margin="0,0,8,0" ToolTip="{Binding StatusSummary}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                     Fill="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding TransportLabel}"
                                       Margin="7,0,0,0"
                                       FontSize="10.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                        </StackPanel>
                    </Border>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding OpenPairingCommand}"
                            ToolTip="Pair a phone">
                        <TextBlock Text="&#xE8EA;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                    </Button>
                    <Button Style="{StaticResource IconButton}"
                            Command="{Binding NavigateCommand}"
                            CommandParameter="Settings"
                            ToolTip="Settings">
                        <TextBlock Text="&#xE713;" FontFamily="{StaticResource IconFont}" FontSize="16" />
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Toast / notice -->
            <Border Grid.Row="1"
                    Margin="28,14,28,0"
                    Padding="12,10"
                    CornerRadius="9"
                    Background="{StaticResource AccentSoftBrush}"
                    BorderBrush="#2B5C4E"
                    BorderThickness="1"
                    Visibility="{Binding HasNotice, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE946;"
                               FontFamily="{StaticResource IconFont}"
                               FontSize="14"
                               Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Top"
                               Margin="0,1,9,0" />
                    <TextBlock Grid.Column="1"
                               Text="{Binding NoticeText}"
                               FontSize="12"
                               Foreground="{StaticResource TextBrush}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            Style="{StaticResource IconButton}"
                            Width="26" Height="26"
                            Command="{Binding DismissNoticeCommand}">
                        <TextBlock Text="&#xE711;" FontFamily="{StaticResource IconFont}" FontSize="11" />
                    </Button>
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="28,18,28,24">
                <views:DashboardView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Dashboard}" />
                <views:GamesView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Games}" />
                <views:SessionsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Sessions}" />
                <views:DevicesView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Devices}" />
                <views:SettingsView Visibility="{Binding Page, Converter={StaticResource PageVis}, ConverterParameter=Settings}" />
            </Grid>
        </Grid>
    </Grid>
</Window>
