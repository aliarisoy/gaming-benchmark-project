<UserControl x:Class="RigSight.Agent.Views.SessionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:RigSight.Agent.Controls">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Sessions" Style="{StaticResource H1}" />
                <TextBlock Text="Every accepted session is saved on this PC. Raw samples stay next to the summary."
                           Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>
            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="{Binding SessionCountText}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" />
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,20,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource Card}" Padding="8">
                <Grid>
                    <ListBox Style="{StaticResource PlainList}"
                             ItemsSource="{Binding Sessions}"
                             SelectedItem="{Binding SelectedSession, Mode=TwoWay}"
                             Visibility="{Binding HasSessions, Converter={StaticResource BoolToVis}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="42" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="34" Height="34" CornerRadius="8"
                                            Background="{StaticResource SurfaceAltBrush}"
                                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Initials}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextDimBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding GameName}" FontSize="13" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding DateLabel}" FontSize="10.5" Margin="0,2,0,0"
                                                   Foreground="{StaticResource TextFaintBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding AvgFpsText}" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text=" FPS" FontSize="9" VerticalAlignment="Bottom" Margin="0,0,0,2"
                                                       Foreground="{StaticResource TextFaintBrush}" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding DurationLabel}" FontSize="10" Margin="0,1,0,0"
                                                   HorizontalAlignment="Right" Foreground="{StaticResource TextFaintBrush}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16,40"
                                Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVis}}">
                        <TextBlock Text="&#xE81C;" FontFamily="{StaticResource IconFont}" FontSize="30"
                                   Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="No sessions yet" Style="{StaticResource H3}" HorizontalAlignment="Center" Margin="0,12,0,0" />
                        <TextBlock Text="Launch a game and accept the prompt. History appears here and on your phone."
                                   Style="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0"
                    Visibility="{Binding HasSelectedSession, Converter={StaticResource BoolToVis}}">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,5,0">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="SESSION DETAIL" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding SelectedSession.GameName}" Style="{StaticResource H1}"
                                           Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="{Binding SelectedSession.DateLabel}" Style="{StaticResource Muted}" />
                                    <TextBlock Text=" · " Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Text="{Binding SelectedSession.DurationLabel}" Style="{StaticResource Muted}" />
                                    <TextBlock Text=" · " Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Text="{Binding SelectedSession.StopReasonLabel}" Style="{StaticResource Muted}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource SecondaryButton}" Content="Export CSV"
                                        Command="{Binding ExportSessionCommand}"
                                        CommandParameter="{Binding SelectedSession}" />
                                <Button Style="{StaticResource IconButton}" Margin="4,0,0,0" ToolTip="Open session folder"
                                        Command="{Binding OpenSessionFolderCommand}"
                                        CommandParameter="{Binding SelectedSession}">
                                    <TextBlock Text="&#xE838;" FontFamily="{StaticResource IconFont}" FontSize="15" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" ToolTip="Delete session"
                                        Command="{Binding DeleteSessionCommand}"
                                        CommandParameter="{Binding SelectedSession}"
                                        Foreground="{StaticResource DangerBrush}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource Divider}" Margin="0,16,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="AVG FPS" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding SelectedSession.AvgFpsText}" Style="{StaticResource Metric}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="1% LOW" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding SelectedSession.Low1Text}" Style="{StaticResource Metric}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="0.1% LOW" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding SelectedSession.Low01Text}" Style="{StaticResource Metric}" Margin="0,4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="3">
                                <TextBlock Text="FRAME TIME" Style="{StaticResource Overline}" />
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding SelectedSession.FrameTimeText}" Style="{StaticResource Metric}" />
                                    <TextBlock Text="ms" FontSize="11" VerticalAlignment="Bottom" Margin="3,0,0,4"
                                               Foreground="{StaticResource TextFaintBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <Border Style="{StaticResource CardTight}" Margin="0,18,0,0" Background="{StaticResource SurfaceAltBrush}">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="FRAME RATE" Style="{StaticResource Overline}" />
                                    <TextBlock Text="{Binding SelectedChartCaption}" HorizontalAlignment="Right"
                                               FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                </Grid>
                                <controls:TelemetryChart Margin="0,8,0,0" Height="170"
                                                         Values="{Binding SelectedFpsSeries}"
                                                         SecondaryValues="{Binding SelectedLowSeries}"
                                                         EmptyText="Raw samples are not available"
                                                         ValueSuffix=" FPS" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="GPU PEAK TEMP" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding SelectedSession.GpuTempText}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                <TextBlock Text="CPU PEAK TEMP" Style="{StaticResource Overline}" Margin="0,13,0,0" />
                                <TextBlock Text="{Binding SelectedSession.CpuTempText}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="GPU PEAK POWER" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding SelectedSession.GpuPowerText}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                <TextBlock Text="CPU PEAK POWER" Style="{StaticResource Overline}" Margin="0,13,0,0" />
                                <TextBlock Text="{Binding SelectedSession.CpuPowerText}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="GPU LOAD" Style="{StaticResource Overline}" />
                                <TextBlock Text="{Binding SelectedSession.GpuLoadText}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                                <TextBlock Text="CPU LOAD" Style="{StaticResource Overline}" Margin="0,13,0,0" />
                                <TextBlock Text="{Binding SelectedSession.CpuLoadText}" FontSize="17" FontWeight="SemiBold" Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="{Binding SelectedSession.SamplesText}" Margin="0,16,0,0"
                                   FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource Card}" Margin="14,0,0,0"
                    Visibility="{Binding HasSelectedSession, Converter={StaticResource InverseBoolToVis}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30">
                    <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="34"
                               Foreground="{StaticResource TextFaintBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="Pick a session" Style="{StaticResource H2}" Margin="0,14,0,0" HorizontalAlignment="Center" />
                    <TextBlock Text="Select a session on the left to see its summary and full-resolution chart."
                               Style="{StaticResource Body}" TextAlignment="Center" MaxWidth="320" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
