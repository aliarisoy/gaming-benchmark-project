<UserControl x:Class="RigSight.Agent.Views.GamesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid>
            <StackPanel>
                <TextBlock Text="Games" Style="{StaticResource H1}" />
                <TextBlock Text="Only these executables are watched. Launching one asks before tracking."
                           Style="{StaticResource Body}" Margin="0,4,0,0" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <Border Style="{StaticResource Chip}" Margin="0,0,10,0">
                    <TextBlock Text="{Binding GameCountText}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" />
                </Border>
                <Button Style="{StaticResource PrimaryButton}" Content="Add game…" Command="{Binding AddGameCommand}" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0" Padding="10">
            <Grid>
                <ListBox Style="{StaticResource PlainList}"
                         ItemsSource="{Binding Games}"
                         Visibility="{Binding HasGames, Converter={StaticResource BoolToVis}}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="6,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="38" Height="38" CornerRadius="9" Background="{StaticResource AccentSoftBrush}"
                                        BorderBrush="#2B5C4E" BorderThickness="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Initials}"
                                               FontFamily="{StaticResource DisplayFont}"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,16,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ExePath}" Margin="0,2,0,0" FontSize="10.5"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding ExePath}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,16,0">
                                    <TextBlock Text="{Binding LastPlayedLabel}" FontSize="10.5"
                                               Foreground="{StaticResource TextFaintBrush}"
                                               HorizontalAlignment="Right" />
                                </StackPanel>

                                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Border Style="{StaticResource ChipAccent}" Padding="8,3"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6" Fill="{StaticResource AccentBrush}" VerticalAlignment="Center" />
                                            <TextBlock Text="RUNNING" Margin="5,0,0,0" FontSize="9" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentBrush}" />
                                        </StackPanel>
                                    </Border>
                                    <Button Style="{StaticResource PrimaryButton}"
                                            Margin="8,0,0,0" Padding="12,6" FontSize="11.5"
                                            Content="Start"
                                            Command="{Binding DataContext.StartGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <Button Grid.Column="4"
                                        Style="{StaticResource IconButton}"
                                        Margin="10,0,0,0"
                                        ToolTip="Remove from library"
                                        Command="{Binding DataContext.RemoveGameCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}">
                                    <TextBlock Text="&#xE74D;" FontFamily="{StaticResource IconFont}" FontSize="14" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,50"
                            Visibility="{Binding HasGames, Converter={StaticResource InverseBoolToVis}}">
                    <Border Width="62" Height="62" CornerRadius="18" Background="{StaticResource SurfaceAltBrush}"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE7FC;" FontFamily="{StaticResource IconFont}" FontSize="26"
                                   Foreground="{StaticResource AccentBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="No games yet" Style="{StaticResource H2}" HorizontalAlignment="Center" Margin="0,16,0,0" />
                    <TextBlock Text="Add the .exe for a game you play. RigSight watches for it and prompts on launch."
                               Style="{StaticResource Body}" MaxWidth="420" TextAlignment="Center" Margin="0,6,0,0" />
                    <Button Style="{StaticResource PrimaryButton}" Content="Add your first game" Margin="0,18,0,0"
                            HorizontalAlignment="Center" Command="{Binding AddGameCommand}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
