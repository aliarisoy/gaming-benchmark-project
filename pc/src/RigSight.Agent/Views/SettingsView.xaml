<UserControl x:Class="RigSight.Agent.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,4,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Settings" Style="{StaticResource H1}" />
                    <TextBlock Text="Agent behavior on this PC. Sensor access and the phone link are independent."
                               Style="{StaticResource Body}" Margin="0,4,0,0" />
                </StackPanel>
                <Border Style="{StaticResource Chip}" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding VersionText}" FontSize="10.5" Foreground="{StaticResource TextDimBrush}" />
                </Border>
            </Grid>

            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.25*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource Card}" Padding="24">
                    <StackPanel>
                        <TextBlock Text="GENERAL" Style="{StaticResource Overline}" />

                        <TextBlock Text="PC display name" Style="{StaticResource TextFieldLabel}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding PcDisplayName, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Shown to your phone during pairing and in the device list."
                                   FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,5,0,0" />

                        <TextBlock Text="Wi-Fi port" Style="{StaticResource TextFieldLabel}" Margin="0,16,0,6" />
                        <TextBox Style="{StaticResource InputBox}" Text="{Binding WsPortText, UpdateSourceTrigger=PropertyChanged}"
                                 Width="140" HorizontalAlignment="Left" />
                        <TextBlock Text="Default 47823. Changing the port takes effect after restarting RigSight."
                                   FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,5,0,0" />

                        <TextBlock Text="Sample interval" Style="{StaticResource TextFieldLabel}" Margin="0,16,0,8" />
                        <ListBox Style="{StaticResource SegmentList}"
                                 ItemContainerStyle="{StaticResource SegmentItem}"
                                 ItemsSource="{Binding SampleIntervalOptions}"
                                 SelectedItem="{Binding SelectedInterval, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Label}" FontSize="11.5" FontWeight="Medium"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" />
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock Text="Applies to the next session. 0.5 s keeps files small without hiding stutter."
                                   FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0" />

                        <Border Style="{StaticResource Divider}" Margin="0,20,0,0" />

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Notify phone on game launch" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Send the game prompt to paired phones as soon as the PC detects it."
                                           FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,3,10,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding NotifyPhone}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Start minimized" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Open straight to the tray when RigSight launches."
                                           FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,3,10,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding StartMinimized}" VerticalAlignment="Center" />
                        </Grid>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Launch at sign-in" FontSize="12.5" FontWeight="SemiBold" />
                                <TextBlock Text="Adds RigSight to your user Run key. Windows will ask for administrator approval at sign-in."
                                           FontSize="10.5" Foreground="{StaticResource TextFaintBrush}" Margin="0,3,10,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox Grid.Column="1" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding AutoStartAtLogin}" VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Content="Save settings" Command="{Binding SaveSettingsCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding SettingsNote}" Margin="0,10,0,0" FontSize="11"
                                   Foreground="{StaticResource AccentBrush}" TextWrapping="Wrap"
                                   Visibility="{Binding SettingsNote, Converter={StaticResource StringToVis}}" />
                    </StackPanel>
                </Border>

                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="SENSORS &amp; CAPTURE" Style="{StaticResource Overline}" />
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Text="{Binding CpuName}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CpuTempValue, StringFormat={}{0} °C}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                            </Grid>
                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="GPU" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Text="{Binding GpuName}" FontSize="12" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" Margin="0,2,8,0" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding GpuTempValue, StringFormat={}{0} °C}"
                                           FontSize="13" FontWeight="SemiBold" VerticalAlignment="Bottom" />
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="FPS capture" FontSize="10" Foreground="{StaticResource TextFaintBrush}" />
                                    <TextBlock Text="{Binding FpsStatusText}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0" />
                                </StackPanel>
                                <Border Grid.Column="1" Style="{StaticResource Chip}" Padding="8,3" VerticalAlignment="Center">
                                    <TextBlock Text="NO OVERLAY" FontSize="8.5" FontWeight="Bold" Foreground="{StaticResource TextDimBrush}" />
                                </Border>
                            </Grid>

                            <Border Style="{StaticResource Divider}" Margin="0,16,0,0" />

                            <TextBlock Text="{Binding SensorMode}" Margin="0,14,0,0" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="{Binding SensorWarning}" FontSize="10.5" TextWrapping="Wrap"
                                       Foreground="{StaticResource WarningBrush}" Margin="0,5,0,0"
                                       Visibility="{Binding SensorWarning, Converter={StaticResource StringToVis}}" />
                            <TextBlock Text="RigSight reads sensors observationally. It never controls fans, clocks, or voltages."
                                       FontSize="10" TextWrapping="Wrap" Foreground="{StaticResource TextFaintBrush}" Margin="0,6,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="HOTKEYS" Style="{StaticResource Overline}" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Start tracking foreground game" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="Ctrl+Alt+G" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource TextBrush}" />
                            </Grid>
                            <Grid Margin="0,7,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Stop the active session" FontSize="11.5" Foreground="{StaticResource TextDimBrush}" />
                                <TextBlock Grid.Column="1" Text="Ctrl+Alt+S" FontFamily="{StaticResource MonoFont}" FontSize="11"
                                           Foreground="{StaticResource TextBrush}" />
                            </Grid>
                            <TextBlock Text="Hotkeys work even while a game is fullscreen."
                                       FontSize="10" Foreground="{StaticResource TextFaintBrush}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                        <StackPanel>
                            <TextBlock Text="DATA &amp; DIAGNOSTICS" Style="{StaticResource Overline}" />
                            <TextBlock Text="{Binding DataFolder}" FontFamily="{StaticResource MonoFont}" FontSize="10"
                                       Foreground="{StaticResource TextDimBrush}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                <Button Style="{StaticResource SecondaryButton}" Content="Open data" Command="{Binding OpenDataFolderCommand}" />
                                <Button Style="{StaticResource SecondaryButton}" Content="Open logs" Margin="8,0,0,0" Command="{Binding OpenLogsFolderCommand}" />
                            </StackPanel>
                            <Border Style="{StaticResource Divider}" Margin="0,16,0,0" />
                            <Button Style="{StaticResource DangerButton}" Content="Exit RigSight" Margin="0,14,0,0"
                                    HorizontalAlignment="Left" Command="{Binding ExitCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
